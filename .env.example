ASPNETCORE_ENVIRONMENT=Development

# Database configuration
Postgres_ConnectionString=Host=localhost;Port=5432;Database=file_service;Username=postgres;Password=postgres

# Cloudinary (for image storage)
Storage__Cloudinary__CloudName=
Storage__Cloudinary__ApiKey=
Storage__Cloudinary__ApiSecret=
Storage__Cloudinary__UploadPreset=
Storage__Cloudinary__StagingFolder=staging
Storage__Cloudinary__PublicFolder=files

# Default storage provider (Cloudinary or AmazonS3)
Storage__DefaultProvider=AmazonS3

# Amazon S3 Configuration
Storage__S3__BucketName=
Storage__S3__Region=
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ServiceUrl=
Storage__S3__ForcePathStyle=false
Storage__S3__StagingFolder=staging
Storage__S3__PublicFolder=files
Staging__TtlMinutes=15

# Service auth
ServiceAuth__Token=
BaseUrl=